import requests
import pandas as pd
from sqlalchemy import create_engine

url = "https://api.frankfurter.dev/v1/2026-01-01..2026-08-01?from=USD&to=EUR,GBP"

response = requests.get(url)
response.raise_for_status() # سطر لفحص حالة الاستجابة في حال حدوث خطأ

print(response.url)
print(response.status_code)
print(response.text[:500])

data = response.json() #to convert json to python dic

df= pd.DataFrame(data["rates"]).T #convert the data into dataframe and trnapose the table 
df.index.name="Date" #to make sure that all rows is connected with specific date
df=df.reset_index() #conver index column into normal column

print(df.head())

df = df.melt( # we use melt function to convert columns into rows  
    id_vars=["Date"], #id_vars is a specific word in python and it means that this column will not be converted
    var_name="TargetCurrency",
    value_name="ExchangeRate"
)

df["BaseCurrency"] = "USD"
df["ExtractedAt"] = pd.Timestamp.now()

print(df.head())

df["Date"] = pd.to_datetime(df["Date"]) #convert data column into date data type
df["ExchangeRate"] = pd.to_numeric(df["ExchangeRate"], errors="coerce") #convert exchange rate to numeric value

df = df.dropna(subset=["Date", "ExchangeRate"]) #drop any rows that contains a missing data
df = df.drop_duplicates(
    subset=["Date", "BaseCurrency", "TargetCurrency"] #drop duplicates based on the 3 columns
)

print(df.info())
print(df.isnull().sum()) #to check the missing values, if all columns are zero then there is no missing data

df["Year"] = df["Date"].dt.year
df["Month"] = df["Date"].dt.month
df["MonthName"] = df["Date"].dt.month_name()
df["YearMonth"] = df["Date"].dt.to_period("M").astype(str)

print(df.head())

print("Total rows:", len(df))
print("Currencies:", df["TargetCurrency"].unique())
print("Date range:", df["Date"].min(), "to", df["Date"].max())

df.to_csv("exchange_rates.csv", index=False)

